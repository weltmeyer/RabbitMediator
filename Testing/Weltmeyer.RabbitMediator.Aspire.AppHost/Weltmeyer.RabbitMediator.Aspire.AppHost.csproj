<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="9.0.0"/>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAspireHost>true</IsAspireHost>
        <UserSecretsId>6ae1dcc3-9aaa-4719-b7e3-32420e5fbc0d</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- Pins the MessagePack that Aspire pulls in through StreamJsonRpc: 2.5.192 carries two high
             severity advisories. Upgrading Aspire itself instead makes the test fixture unusable. -->
        <PackageReference Include="MessagePack" Version="2.5.302" />
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.2.4" />
        <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.2.4" />
    </ItemGroup>

</Project>
